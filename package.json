{
  "name": "@mriekki/project-forge",
  "version": "4.13.1",
  "description": "Public consumer distribution and updater for Project Forge engineering assets.",
  "type": "module",
  "bin": {
    "project-forge": "bin/project-forge.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "assemble:assets": "node scripts/assemble-assets.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "prepack": "npm run verify:assets"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mriekki/project-forge-platform.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
